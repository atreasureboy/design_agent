  {
    "id": "context-compression",
    "namespace": "core",
    "name": "上下文压缩",
    "description": "上下文超阈值时压缩历史：摘要/滑窗/层级/选择性丢弃",
    "parentId": "context-engineering",
    "allowMultiple": false,
    "extensionPoint": false,
    "runtimeFamilies": "any",
    "properties": {
      "strategy": {
        "kind": "enum",
        "values": [
          "summary",
          "sliding-window",
          "hierarchical",
          "selective-drop"
        ],
        "default": "summary"
      },
      "threshold": {
        "kind": "percent",
        "default": 80,
        "min": 10,
        "max": 100
      }
    },
    "mitigates": [
      "context-overflow"
    ],
    "introduces": [
      "information-loss"
    ],
    "constraints": {
      "requires": [],
      "forbids": [],
      "suggests": [
        "episodic-memory"
      ]
    },
    "required": false,
    "references": [
      "dsh packages/compaction",
      "LangGraph trim_messages"
    ],
    "version": "0.1.0",
    "implementations": [
      {
        "name": "summary",
        "note": "LLM 摘要压缩历史，保留语义骨架"
      },
      {
        "name": "sliding-window",
        "note": "保留最近 K 轮，机械但可控"
      },
      {
        "name": "hierarchical",
        "note": "分层摘要：近期原文 + 远期摘要，信息保留最好"
      },
      {
        "name": "selective-drop",
        "note": "按类型丢弃（如旧工具输出），成本最低"
      }
    ],
    "useCases": [
      "长会话成本控制",
      "逼近窗口上限前主动触发"
    ],
    "pros": [
      "token 成本显著下降",
      "会话可长期持续"
    ],
    "cons": [
      "信息丢失风险",
      "摘要质量依赖模型能力"
    ],
    "commonIssues": [
      "压缩后关键事实丢失",
      "历史漂移（早期语境被过度概括）"
    ]
  },
